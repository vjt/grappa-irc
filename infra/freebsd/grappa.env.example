# Grappa env file — chmod 600, owned by the grappa user.
# Loaded by /usr/local/etc/rc.d/grappa via the `grappa_env_file` rc.conf knob.
#
# Per CLAUDE.md "Security": SECRET_KEY_BASE, RELEASE_COOKIE, GRAPPA_ENCRYPTION_KEY,
# SASL passwords never logged, never committed. This file is a template only —
# fill in real values on the target host and `chmod 600`.

# ── Phoenix / Plug ─────────────────────────────────────────────────────────
# Generate with: bin/grappa eval 'Base.encode64(:crypto.strong_rand_bytes(48))'
# or (from a dev checkout): scripts/mix.sh phx.gen.secret
SECRET_KEY_BASE=REPLACE_ME

# Plug.Session signing salt (32+ random bytes).
# Generate with: scripts/mix.sh phx.gen.secret 32
SECRET_SIGNING_SALT=REPLACE_ME

# BEAM distribution cookie (any 32+ char random). Required when running
# release with `daemon` so `bin/grappa remote` can attach.
# Generate with: openssl rand -hex 32
RELEASE_COOKIE=REPLACE_ME

# ── Cloak vault key ────────────────────────────────────────────────────────
# Base64-encoded 32 bytes. Encrypts at-rest upstream credentials.
# Generate ONCE per deployment with:
#   _build/prod/rel/grappa/bin/grappa eval 'IO.puts(Base.encode64(:crypto.strong_rand_bytes(32)))'
# BACK THIS UP SEPARATELY. Lose the key = lose all stored credentials.
GRAPPA_ENCRYPTION_KEY=REPLACE_ME

# ── Web Push (VAPID) ───────────────────────────────────────────────────────
# Generate ONCE per deployment with:
#   _build/prod/rel/grappa/bin/grappa eval 'Grappa.Push.Vapid.gen_keypair() |> IO.inspect()'
VAPID_PUBLIC_KEY=REPLACE_ME
VAPID_PRIVATE_KEY=REPLACE_ME
VAPID_SUBJECT=mailto:operator@example.org

# ── Storage paths ──────────────────────────────────────────────────────────
# Absolute paths inside the jail. The DB + uploads dirs MUST be writable
# by the grappa user.
#
# ALL THREE MUST be absolute on the jail: the BEAM is started by rc.d
# (rc.d/grappa → `su -m grappa -c '.../bin/grappa daemon'`), which sets NO
# WorkingDirectory, so its CWD is NOT the repo root. config/runtime.exs
# defaults these to repo-root-relative paths (runtime/…), which resolve
# correctly under Docker (WORKDIR /app) and native systemd
# (WorkingDirectory=<repo>) but NOT here — hence the absolute overrides.
# CIC_DIST_ROOT is where the BEAM reads the built cicchetto index.html to
# broadcast the refresh-banner hash; unset it and /admin/cic-bundle-changed
# returns 204 and no banner ever fires (issue #526). It must equal the
# `--outDir` jail_cic_build.sh writes — the BEAM serves that dir itself
# via Plug.Static since #485; nginx fronts nothing from disk.
DATABASE_PATH=/home/grappa/grappa/runtime/grappa_prod.db
UPLOADS_STORAGE_ROOT=/home/grappa/grappa/runtime/uploads
CIC_DIST_ROOT=/home/grappa/grappa/runtime/cicchetto-dist

# ── Phoenix host ───────────────────────────────────────────────────────────
# MANDATORY in prod — NO default. config/runtime.exs RAISES at boot if
# unset/empty, so an unedited copy fails LOUDLY instead of minting dead
# upload links + rejecting WS handshakes. Set to YOUR public hostname
# (e.g. grappa.example.org).
PHX_HOST=
PORT=4000

# Extra WS check_origin origins + #324 HTTP host-alias source. Prod pins
# to PHX_HOST only; escape-hatch for raw-IP / secondary vhost. Unset = none.
# EXTRA_CHECK_ORIGINS=https://irc.example.org

# Sqlite pool size (read concurrency). Defaults to 10 if unset.
POOL_SIZE=10

# Logger level: debug | info | notice | warning | error
LOG_LEVEL=info

# ── Outbound v6 pool — #228 DB-seed input; NDP keepalive retired (#628) ──────
# The app does NOT read this at runtime — the outbound rotation pool is
# DB-driven (vhosts.in_pool). It is read ONCE at #228 migrate-time to seed the
# DB pool on a fresh deploy, so keep it set through the first ecto.migrate. Its
# only service consumer, the grappa_ndp_keepalive daemon, was retired
# 2026-08-02 (#628) and its files were deleted in #923 — the migrate-time seed
# is the ONLY remaining reader. Placeholder addresses below; set your real
# bound /128s.
GRAPPA_OUTBOUND_V6_POOL=2001:db8::1,2001:db8::2

# ── T31 admission captcha (optional) ───────────────────────────────────────
# GRAPPA_CAPTCHA_PROVIDER=disabled
# GRAPPA_CAPTCHA_SITE_KEY=
# GRAPPA_CAPTCHA_SECRET=

# ── BEAM resource caps (optional) ──────────────────────────────────────────
# GRAPPA_MAX_USERS=100
# GRAPPA_DIRTY_SCHEDULERS=
