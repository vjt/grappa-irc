#!/bin/sh
#
# shellcheck disable=SC1091,SC2034,SC2223
# File-wide, and each code is the rc.subr CONTRACT rather than a defect:
#   SC1091 — /etc/rc.subr exists on the FreeBSD host, never on the linter's.
#   SC2034 — rcvar/pidfile/command/extra_commands/*_cmd are READ BY rc.subr
#            after we set them; "unused here" is how the interface works.
#   SC2223 — `: ${var:="default"}` is THE rc.d default-assignment idiom, used
#            by every script under /usr/local/etc/rc.d.
# Everything else stays linted: this mutes three known-idiomatic codes, not
# the file (#441).
#
# PROVIDE: grappa_ndp_keepalive
# REQUIRE: NETWORKING
# KEYWORD: shutdown
#
# =============================================================================
# DEPRECATED (GH #628) — retired 2026-08-02, the VNET jail cutover.
# NO LONGER INSTALLED. Kept in the tree ON PURPOSE.
# =============================================================================
# jail_install_rcd.sh no longer copies this into /usr/local/etc/rc.d nor writes
# an _enable="YES" rc.conf.d entry, so it is out of the boot path. Left in place
# deliberately ("fa fico avere un sorcio in perl") and still functional if an
# operator installs it by hand. WHY it is dead weight: the bouncer now runs in a
# VNET jail on a ROUTED /64 (per-session sources bound as /128s on lo0) — the
# provider routes the block to us, there is no proxy-NDP neighbour cache to keep
# warm. Full rationale + how to resurrect: ndp_keepalive.pl.
# =============================================================================
#
# Background NDP keepalive — pings the default v6 gateway from every
# source address in GRAPPA_OUTBOUND_V6_POOL every N seconds so the
# upstream router's NDP table never expires a pool entry.
#
# Adds to /etc/rc.conf (or /etc/rc.conf.d/grappa_ndp_keepalive):
#   grappa_ndp_keepalive_enable="YES"
#   grappa_ndp_keepalive_env_file="/usr/local/etc/grappa/grappa.env"  # optional
#   grappa_ndp_keepalive_interval="10"                                # optional, seconds between bursts
#   grappa_ndp_keepalive_count="3"                                    # optional, packets per burst per source
#   grappa_ndp_keepalive_gateway="fe80::1%vtnet0"                     # optional, pin gateway (required in shared-IP jails)
#
# Wraps daemon(8) for pid + stop semantics; the actual loop lives in
# /home/grappa/grappa/infra/freebsd/ndp_keepalive.sh.

. /etc/rc.subr

name="grappa_ndp_keepalive"
rcvar="grappa_ndp_keepalive_enable"

load_rc_config "$name"

: ${grappa_ndp_keepalive_enable:="NO"}
: ${grappa_ndp_keepalive_env_file:="/usr/local/etc/grappa/grappa.env"}
: ${grappa_ndp_keepalive_interval:="10"}
: ${grappa_ndp_keepalive_count:="3"}
: ${grappa_ndp_keepalive_gateway:=""}
: ${grappa_ndp_keepalive_script:="/home/grappa/grappa/infra/freebsd/ndp_keepalive.sh"}

pidfile="/var/run/${name}.pid"
command="/usr/sbin/daemon"
command_args="-P ${pidfile} -r -f -- /bin/sh ${grappa_ndp_keepalive_script}"

start_precmd="grappa_ndp_keepalive_precmd"

grappa_ndp_keepalive_precmd() {
	if [ ! -r "${grappa_ndp_keepalive_env_file}" ]; then
		warn "env file ${grappa_ndp_keepalive_env_file} not readable — refusing to start"
		return 1
	fi
	if [ ! -x "${grappa_ndp_keepalive_script}" ]; then
		warn "loop script ${grappa_ndp_keepalive_script} not executable — refusing to start"
		return 1
	fi
	export GRAPPA_ENV_FILE="${grappa_ndp_keepalive_env_file}"
	export GRAPPA_NDP_KEEPALIVE_INTERVAL="${grappa_ndp_keepalive_interval}"
	export GRAPPA_NDP_KEEPALIVE_COUNT="${grappa_ndp_keepalive_count}"
	export GRAPPA_NDP_KEEPALIVE_GATEWAY="${grappa_ndp_keepalive_gateway}"
}

run_rc_command "$1"
