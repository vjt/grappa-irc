# Grappa IRC bouncer — systemd unit for the packaged install (.deb/.rpm).
# Installed to /usr/lib/systemd/system/grappa.service (vendor unit dir;
# operator overrides go in /etc/systemd/system/grappa.service.d/).
#
# Fixed FHS paths — the package owns them:
#   /usr/lib/grappa      the mix release (self-contained ERTS + app)
#   /usr/share/grappa    the cicchetto SPA dist (CIC_DIST_ROOT)
#   /etc/grappa          the env file (secrets, PHX_HOST)
#   /var/lib/grappa      state: sqlite DB, uploads, run_erl tmp
#
# `bin/grappa start` runs the release in the FOREGROUND (not `daemon`), so
# Type=exec tracks the real PID: stop/restart send SIGTERM and BLOCK until
# it exits (bounded by TimeoutStopSec), letting the app QUIT upstream
# cleanly. Do NOT switch to `daemon` — a detached PID reintroduces the
# stop/start race and needs a custom ExecStop wrapper.
# Why: docs/OPERATIONS.md § "Packaging (infra/packaging/)".

[Unit]
Description=Grappa IRC bouncer
Documentation=https://github.com/vjt/grappa-irc
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=grappa
Group=grappa
WorkingDirectory=/var/lib/grappa

# Root reads this before dropping to User=grappa — the file itself is
# chmod 640 root:grappa (see gen-secrets.sh / postinstall).
EnvironmentFile=/etc/grappa/grappa.env

# UTF-8 locale so the BEAM uses utf8 native name encoding. systemd sets
# no LANG by default, and without a UTF-8 locale Elixir warns "the VM is
# running with native name encoding of latin1 which may cause Elixir to
# malfunction" — real risk here since IRC nicks/channels/filenames are
# UTF-8. C.UTF-8 is always present on glibc (no locale-gen).
Environment=LANG=C.UTF-8

# run_erl (only used by `bin/grappa daemon`/`remote`) + any transient
# release state writes under here rather than the read-only /usr/lib
# release tree.
Environment=RELEASE_TMP=/var/lib/grappa

# Migrate BEFORE the release starts (issue 1112): a restart then serves the
# new code on the schema it expects, never the other way round. Pending
# migrations only, so a start with none costs one short eval. A failed
# migration fails the start — the unit does not come up on a half-applied
# schema — and shows up in `journalctl -u grappa`.
ExecStartPre=/usr/lib/grappa/bin/grappa eval 'Grappa.Release.migrate()'
ExecStart=/usr/lib/grappa/bin/grappa start

# Bounds ExecStartPre too, so it is sized for a migration, not for a boot
# (R7 of issue 1112): the 30 s this was would kill a long migration halfway.
# How long real migrations take is not measured; 300 is the ruling's figure.
TimeoutStartSec=300
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

# Hardening: the release tree (/usr/lib/grappa) + dist (/usr/share/grappa)
# are read-only to the running app; only the state dir is writable.
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/grappa
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
