# Grappa env file — installed to /etc/grappa/grappa.env (chmod 640,
# owned by root:grappa). Shipped by the .deb/.rpm as
# /usr/share/grappa/grappa.env.example; postinstall copies it into
# /etc/grappa/grappa.env on FIRST install only (never on upgrade), then
# fills the REPLACE_ME secrets via /usr/share/grappa/gen-secrets.sh
# (openssl only — a packaged host has no mix/release toolchain).
#
# Loaded via `EnvironmentFile=` in the packaged systemd unit
# (/usr/lib/systemd/system/grappa.service). systemd's manager (root)
# reads this BEFORE dropping to User=grappa, so the file need not be
# world/grappa-readable. This is systemd env-file syntax, NOT a shell
# script — plain KEY=VALUE lines only, no `export`, no quoting, no shell
# expansion. base64 secrets (with +, /, = characters) are safe here:
# values are literal to end-of-line.
#
# SECRET_KEY_BASE, RELEASE_COOKIE, GRAPPA_ENCRYPTION_KEY and SASL
# passwords are never logged and must never be committed.

# ── Phoenix host — the ONE value the operator MUST set by hand ──────────────
# Public hostname the bouncer is reached at. The service refuses to
# START until this is a real hostname (postinstall enables but does NOT
# start grappa). config/runtime.exs roots generated upload links here
# AND gates the WebSocket check_origin, so a wrong value mints dead
# links into permanent scrollback + rejects every WS handshake.
PHX_HOST=REPLACE_ME
PORT=4000

# ── Secrets (auto-generated by gen-secrets.sh at first install) ─────────────
# Left as REPLACE_ME in the template; postinstall fills them via openssl.
# To rotate later: edit to REPLACE_ME (or blank) and run
# `sudo grappa gen-secrets`, then restart. Back up GRAPPA_ENCRYPTION_KEY
# separately — losing it loses every stored upstream credential.
SECRET_KEY_BASE=REPLACE_ME
SECRET_SIGNING_SALT=REPLACE_ME
RELEASE_COOKIE=REPLACE_ME
GRAPPA_ENCRYPTION_KEY=REPLACE_ME
VAPID_PUBLIC_KEY=REPLACE_ME
VAPID_PRIVATE_KEY=REPLACE_ME
VAPID_SUBJECT=mailto:operator@example.org

# Push endpoint hosts exempt from the endpoint address policy (#2401). A
# client's push endpoint must be https on a PUBLIC address; a host listed
# here may be private and plain http. Only for a UnifiedPush distributor
# (ntfy, say) on your own LAN. Comma-separated hostnames or IP literals.
# PUSH_ALLOWED_PRIVATE_HOSTS=ntfy.lan

# ── Storage paths (FHS — packaged defaults) ────────────────────────────────
# Owned by / writable by the grappa system user (postinstall chowns
# /var/lib/grappa). The DB + uploads live under the package's state dir.
DATABASE_PATH=/var/lib/grappa/grappa.db
UPLOADS_STORAGE_ROOT=/var/lib/grappa/uploads

# ── cicchetto SPA bundle ───────────────────────────────────────────────────
# The BEAM self-serves the built frontend from here (Plug.Static + SPA
# history-fallback), so nginx is recommended for TLS but NOT required.
# The package ships the built dist at this read-only share path. Do NOT
# point this at a writable dir — it is served as static assets.
CIC_DIST_ROOT=/usr/share/grappa/cicchetto-dist

# ── Optional ────────────────────────────────────────────────────────────────
# Extra WS check_origin origins + HTTP host-alias source. Prod pins to
# PHX_HOST only; escape-hatch for raw-IP / secondary vhost.
# EXTRA_CHECK_ORIGINS=https://irc.example.org
#
# Sqlite read-concurrency pool (defaults to 5). SQLite has one writer, so this
# buys reads only. Keep it BELOW the BEAM's dirty-IO scheduler count (10 by
# default — see ERL_ZFLAGS below): every SQLite call runs inside a dirty-IO
# NIF, so at parity a saturated pool can occupy every one of them. grappa
# warns at boot if that relation is lost.
# POOL_SIZE=5
#
# BEAM boot flags. This package runs the release under systemd with no
# container entrypoint, so GRAPPA_MAX_USERS / GRAPPA_DIRTY_SCHEDULERS (the
# Docker knobs) are NOT read here; ERL_ZFLAGS is the lever that is, and
# systemd loads this file via EnvironmentFile. +SDio sets the dirty-IO
# scheduler count, which ERTS fixes at 10 regardless of CPU count.
#
# ⚠️ Raising it buys reserve while a writer is parked on the file lock, NOT
# write throughput (SQLite has one writer) and not a shorter stall. Each is an
# OS thread with its own allocator carriers; on a small VPS the default is
# usually right.
# ERL_ZFLAGS=+SDio 16
#
# Logger level: debug | info | notice | warning | error. Logs go to
# `journalctl -u grappa` (Type=exec foreground).
LOG_LEVEL=info
#
# Admission captcha (default disabled).
# GRAPPA_CAPTCHA_PROVIDER=disabled
# GRAPPA_CAPTCHA_SITE_KEY=
# GRAPPA_CAPTCHA_SECRET=
