# Dockerfile.shottino — the `shottino --ircd` bridge as a compose service
# (#1027). A small image of its own, built only when the `ircd` profile is
# used; why it is not a stage in the bouncer image, and why it needs no ABI
# lockstep gate, is in docs/OPERATIONS.md § "The shottino --ircd bridge as a
# compose service (#1027)".

# ── Stage 1: build ──────────────────────────────────────────────────────────
FROM alpine:3.24 AS build

# pkgconf is required: build-base does not carry pkg-config on alpine, and
# `configure` fails at its first check without it. ncurses-dev ships
# ncursesw.pc (shottino links the WIDE build) and openssl-dev ships openssl.pc.
# cargo builds the vodozemac staticlib shottino's E2E links (e2e/vodozemac-c).
RUN apk add --no-cache build-base ncurses-dev openssl-dev pkgconf cargo

WORKDIR /src
# Only what the client needs. The vendored libdatachannel submodule belongs to
# the opt-in `make call` helper, which this image does not build.
COPY Makefile configure ./
COPY frontends/shottino/ ./frontends/shottino/
RUN ./configure --prefix=/usr \
    && make -C frontends/shottino \
    && ./frontends/shottino/shottino --help > /dev/null

# ── Stage 2: runtime ────────────────────────────────────────────────────────
FROM alpine:3.24

#   ncurses-libs    — libncursesw, linked even headless
#   openssl         — libssl/libcrypto for the HTTPS + websocket transport
#   ca-certificates — the system CA bundle, for reaching grappa over TLS
RUN apk add --no-cache ncurses-libs openssl ca-certificates

COPY --from=build /src/frontends/shottino/shottino /usr/bin/shottino

# The bridge's state dir; the client appends its own name, so the log lands at
# /state/shottino/ircd.log. Set explicitly, not left to $HOME, because that log
# is a PLAINTEXT transcript of the session and it must be somewhere the
# operator chose.
ENV XDG_DATA_HOME=/state
WORKDIR /state

EXPOSE 6667

# No CMD: the bridge cannot start without a grappa URL and a username, and
# guessing either yields a container that restarts forever against somebody
# else's server. compose.yaml supplies the whole command.
