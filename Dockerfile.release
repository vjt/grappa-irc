# syntax=docker/dockerfile:1
#
# Dockerfile.release — the self-contained grappa RELEASE image published to
# ghcr.io (#503 unit C). It ships a `mix release`: bundled ERTS, compiled
# beams and the built cicchetto SPA, and nothing to compile with. It boots
# `bin/grappa start`; a hot update swaps beams into `lib/grappa-<vsn>/ebin`
# and fires `Grappa.HotReload` (unit E), never the dev reloader.
#
# The top-level `Dockerfile` is a different image with a different role —
# docs/OPERATIONS.md § "The two images: Dockerfile (toolchain) vs
# Dockerfile.release".
#
# Multi-arch: buildx builds linux/amd64 + linux/arm64 from this ONE file.

# ── Stage 1: cicchetto SPA dist ─────────────────────────────────────────────
# bun's binary is musl-built on alpine, so the PWA is built in oven/bun's
# alpine image. node_modules is .dockerignore'd and installed fresh here.
# Digest-pinned (#103 supply-chain) — this is the alpine variant, a SEPARATE
# tag and digest from the debian oven/bun:1 the dev scripts use. Refresh on a
# bump: docker buildx imagetools inspect oven/bun:1-alpine --format '{{.Manifest.Digest}}'
FROM oven/bun:1-alpine@sha256:5acc90a93e91ff07bf72aa90a7c9f0fa189765aec90b47bdbf2152d2196383c0 AS cic
WORKDIR /cic
# Lockfile + manifest first, for a cache-friendly frozen install layer.
COPY cicchetto/package.json cicchetto/bun.lock ./
RUN bun install --frozen-lockfile
COPY cicchetto/ ./
# The vite build REFUSES to run without GRAPPA_VERSION (#538). It is derived
# through the same version.sh the .deb/.rpm/AUR builds use, placed at the
# layout version.sh expects (SCRIPT_DIR/../.. == repo root, so it reads
# ./VERSION, #652), so nothing re-implements the read. `--emptyOutDir`
# because the outDir is outside the vite project root.
#
# #1773 — the credit roll's git facts arrive on the same channel, through the
# same script layout. THIS image is one of the two substrates where they do
# not exist: `.git` is .dockerignore'd (see the Stage-2 note below, which is
# why Grappa.Version takes its no-git path here), so credits.sh reports the
# absence honestly and the roll degrades to the version alone. It must not
# fail, or the release image stops building over an easter egg.
#
# #1834 — so the PUBLISHED image takes them from OUTSIDE instead. The build
# context cannot have the history, but the machine driving the build does:
# release.yml runs the same credits.sh in its full checkout and hands the
# result in as this arg. Measured on the built dist before the change, not
# inferred — `{"sha":null,"date":null,"contributors":[]}` is what
# `ghcr.io/vjt/grappa` was shipping.
#
# `${GRAPPA_CREDITS:-$(sh …)}` and not an `if`, because the point is that the
# in-context derive stays the DEFAULT: a plain `docker build` from a source
# checkout passes no arg, the substitution runs credits.sh exactly as before,
# and the roll degrades honestly. Turning that path into a failure would be a
# worse bug than the one being fixed — vite.config.ts throws on an UNSET
# GRAPPA_CREDITS (a wrapper that forgot to plumb it) and that throw must keep
# meaning only that. The arg is declared INSIDE this stage on purpose: an
# `ARG` is stage-scoped, so one declared next to `mix release` would leave
# `--build-arg` accepted, warned about and silently ignored.
ARG GRAPPA_CREDITS
COPY VERSION ./VERSION
COPY infra/packaging/version.sh ./infra/packaging/version.sh
COPY infra/packaging/credits.sh ./infra/packaging/credits.sh
RUN GRAPPA_VERSION="$(sh infra/packaging/version.sh)" \
    && export GRAPPA_VERSION \
    && GRAPPA_CREDITS="${GRAPPA_CREDITS:-$(sh infra/packaging/credits.sh)}" \
    && export GRAPPA_CREDITS \
    && echo "cic build: GRAPPA_VERSION=${GRAPPA_VERSION}" \
    && bun run build -- --outDir /cic-dist --emptyOutDir

# ── Stage 2: mix release (self-contained ERTS + beams) ──────────────────────
# Same toolchain tuple as the dev image and the .deb builder. exqlite bundles
# its own sqlite amalgamation, so no sqlite-dev is needed here.
FROM elixir:1.20.2-otp-29-alpine AS build
RUN apk add --no-cache build-base git
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    MIX_HOME=/root/.mix \
    HEX_HOME=/root/.hex \
    MIX_ENV=prod
WORKDIR /src
RUN mix local.hex --force && mix local.rebar --force
# VERSION must be COPYed alongside mix.exs, not later: mix.exs reads it at
# project-eval time, so every mix task needs it present, deps.get included
# (#652).
COPY mix.exs mix.lock VERSION ./
RUN mix deps.get --only prod
# Compile and assemble in ONE `mix compile`; a separate `mix deps.compile`
# step only added an emulation-heavy pass under the arm64 QEMU leg.
#
# `.git` is EXCLUDED by .dockerignore, so Grappa.Version takes its no-git path
# and the artifact reports the bare X.Y.Z, like the AUR source tarball (#391).
# The release CI asserts `tag == VERSION` (#652), so bare version equals tag.
COPY config config
COPY lib lib
COPY priv priv
# `mix release` is not just :assemble — mix.exs registers release STEPS that
# read files from the repo, and every path they touch has to be in this build
# context or the release dies at assembly time. Today that is the operator CLI
# (#1158): `install_operator_cli/1` renames the generated launcher aside and
# `File.cp!`s `infra/release/grappa.sh` (mix.exs `@operator_cli`) into its
# place, so `bin/grappa` carries the account verbs. Without this COPY the step
# raises `File.CopyError ... no such file or directory` — which is exactly how
# the v1.0.0 release job died (run 31656721237): the packaging jobs build from
# a full checkout and never noticed, and this image is the only build that
# sees a hand-picked context. If a future release step reads another repo
# path, COPY it here too.
COPY infra/release/grappa.sh infra/release/grappa.sh
RUN mix compile --warnings-as-errors
RUN mix release --overwrite

# Capture the ABI contract the release linked against — musl + openssl SONAME
# majors AND package versions — as KEY=VALUE lines the runtime stage's gate
# reads back. The openssl package name is DERIVED from its SONAME so the
# lookup survives a future libcrypto.so.4; musl's is soname-stable.
RUN set -eu; \
    musl_so="$(ls /lib/libc.musl-*.so.* | sed 's/.*\.so\.//' | head -1)"; \
    musl_pkg="$(apk list --installed musl | head -1 | cut -d' ' -f1)"; \
    ssl_so="$(ls /usr/lib/libcrypto.so.* | sed 's/.*\.so\.//' | head -1)"; \
    ssl_pkg="$(apk list --installed "libcrypto${ssl_so}" | head -1 | cut -d' ' -f1)"; \
    { \
      echo "musl_soname=${musl_so}"; \
      echo "musl_version=${musl_pkg#musl-}"; \
      echo "openssl_soname=${ssl_so}"; \
      echo "openssl_version=${ssl_pkg#libcrypto${ssl_so}-}"; \
    } > /abi-manifest

# ── Stage 3: runtime (deps only, no toolchain) ──────────────────────────────
# `alpine:3.24` is a deliberate FLOOR, not a mirror of the build base: the
# build image resolves to different alpine minors per arch, so no single
# runtime minor can match it. Bump the floor when the gate below fails —
# docs/OPERATIONS.md § "The two images: Dockerfile (toolchain) vs
# Dockerfile.release".
FROM alpine:3.24 AS runtime

# Runtime deps ONLY, installed BEFORE the ABI gate, which inspects the
# runtime's own libcrypto/musl:
#   ncurses         — ERTS links libncursesw (tty/terminal driver)
#   openssl         — libcrypto.so.3/libssl.so.3 for the crypto NIF + #89 TLS
#   libstdc++/libgcc — musl C++/gcc runtime the BeamAsm JIT + NIFs link
#   ca-certificates — the system CA trust store #89 verify_peer reads
#                     (:public_key.cacerts_get/0), for upstream TLS IRC
#   curl            — /healthz probe (HEALTHCHECK) + the loopback hot-deploy
#                     POST unit E fires
#   sqlite          — the sqlite3 CLI for ops (exqlite bundles the LIBRARY;
#                     this is just the operator/debug CLI)
#   exiftool ffmpeg — Grappa.Uploads.MetadataStrip (#39). It fails CLOSED —
#                     without them uploads 422 — so a self-contained image
#                     bundles them.
#   bash            — runs infra/packaging/gen-secrets.sh (#862); alpine's ash
#                     has no `trap … RETURN` and no `set -o pipefail`, which
#                     that script needs to catch a failed openssl mid-pipeline
RUN apk add --no-cache \
        ncurses \
        openssl \
        bash \
        libstdc++ \
        libgcc \
        ca-certificates \
        curl \
        sqlite \
        exiftool \
        ffmpeg

# Build↔runtime ABI lockstep gate: fails the build loudly on a SONAME-major
# drift, or a runtime musl older than the build base (musl has no symbol
# versioning, so build-new/run-old can miss symbols). Logic lives in a tested
# POSIX script — test/infra/abi_lockstep_test.bats.
COPY --from=build /abi-manifest /tmp/abi-manifest
COPY infra/docker/assert-abi-lockstep.sh /tmp/assert-abi-lockstep.sh
RUN set -eu; \
    b_musl_so="$(sed -n 's/^musl_soname=//p' /tmp/abi-manifest)"; \
    b_musl_v="$(sed -n 's/^musl_version=//p' /tmp/abi-manifest)"; \
    b_ssl_so="$(sed -n 's/^openssl_soname=//p' /tmp/abi-manifest)"; \
    b_ssl_v="$(sed -n 's/^openssl_version=//p' /tmp/abi-manifest)"; \
    r_musl_so="$(ls /lib/libc.musl-*.so.* | sed 's/.*\.so\.//' | head -1)"; \
    r_musl_pkg="$(apk list --installed musl | head -1 | cut -d' ' -f1)"; \
    r_musl_v="${r_musl_pkg#musl-}"; \
    r_ssl_so="$(ls /usr/lib/libcrypto.so.* | sed 's/.*\.so\.//' | head -1)"; \
    r_ssl_pkg="$(apk list --installed "libcrypto${r_ssl_so}" | head -1 | cut -d' ' -f1)"; \
    r_ssl_v="${r_ssl_pkg#libcrypto${r_ssl_so}-}"; \
    sh /tmp/assert-abi-lockstep.sh \
        "$b_musl_so" "$b_musl_v" "$b_ssl_so" "$b_ssl_v" \
        "$r_musl_so" "$r_musl_v" "$r_ssl_so" "$r_ssl_v"; \
    rm -f /tmp/abi-manifest /tmp/assert-abi-lockstep.sh

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    HOME=/app
WORKDIR /app

# Non-root runtime user (least privilege). Owns /app + the /data state volume.
RUN addgroup -S grappa \
    && adduser -S -G grappa -h /app grappa \
    && mkdir -p /data \
    && chown grappa:grappa /data

# The assembled release + the built SPA dist + the entrypoint.
COPY --from=build --chown=grappa:grappa /src/_build/prod/rel/grappa ./
COPY --from=cic   --chown=grappa:grappa /cic-dist ./cicchetto-dist
COPY --chown=grappa:grappa infra/docker/release-entrypoint.sh /app/release-entrypoint.sh
# The .deb/.rpm secret generator, verbatim (#862). The entrypoint resolves it
# as `dirname $0`, so the two files MUST stay siblings.
COPY --chown=grappa:grappa infra/packaging/gen-secrets.sh /app/gen-secrets.sh
RUN chmod 0755 /app/release-entrypoint.sh /app/gen-secrets.sh

# Image-baked runtime defaults. SECRETS ARE NOT BAKED — they are generated
# per-install on the /data volume by the entrypoint's first-boot bootstrap
# (#862), and anything the operator supplies wins and is never overwritten.
# PHX_HOST is the one exception: it cannot be invented, so a bare
# `docker run` still RAISES in config/runtime.exs for that alone.
ENV DATABASE_PATH=/data/grappa.db \
    UPLOADS_STORAGE_ROOT=/data/uploads \
    CIC_DIST_ROOT=/app/cicchetto-dist \
    GRAPPA_SUBSTRATE=docker \
    PORT=4000

VOLUME /data
EXPOSE 4000

# Shell-form CMD so ${PORT} expands from the container env at probe time and
# an operator-overridden PORT is followed instead of a hardcoded 4000.
HEALTHCHECK --interval=10s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -fsS "http://localhost:${PORT:-4000}/healthz" || exit 1

USER grappa

# Static OCI labels (the CI job adds dynamic version/revision/source labels).
LABEL org.opencontainers.image.title="grappa" \
      org.opencontainers.image.description="Always-on IRC bouncer + cicchetto PWA — self-contained release image" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="https://github.com/vjt/grappa-irc"

# The entrypoint sizes the BEAM resource caps, then execs `bin/grappa "$@"`.
# Override the CMD for one-shots, e.g. `... eval 'Grappa.Release.migrate()'`.
ENTRYPOINT ["/app/release-entrypoint.sh"]
CMD ["start"]
