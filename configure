#!/bin/sh
# The real script is frontends/shottino/configure: shottino builds from its
# own directory too (#2587), so that is where it lives, and the config.mk it
# writes lands beside the Makefile that reads it. This one exists so a
# clone can still be built with ./configure && make && make install from
# the repository root as well.
exec "$(dirname "$0")/frontends/shottino/configure" "$@"
