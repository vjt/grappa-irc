#!/bin/sh
# shottino's configure. Runs from anywhere — the repository root's
# ./configure forwards here — and always writes config.mk beside the
# Makefile that reads it, never into the caller's working directory.
set -eu

src_dir=$(cd "$(dirname "$0")" && pwd -P)

prefix=/usr/local
bindir=
cc=${CC:-cc}
pkg_config=${PKG_CONFIG:-pkg-config}

usage() {
  cat <<'EOF'
usage: ./configure [OPTIONS]

Options:
  --prefix=PATH       installation prefix (default: /usr/local)
  --bindir=PATH       binary installation directory (default: PREFIX/bin)
  CC=cc               C compiler override
  PKG_CONFIG=cmd      pkg-config override
  CARGO=cmd           cargo override (Rust floor: vodozemac-c's rust-version)
EOF
}

for arg in "$@"; do
  case "$arg" in
    --prefix=*) prefix=${arg#*=} ;;
    --bindir=*) bindir=${arg#*=} ;;
    --help|-h) usage; exit 0 ;;
    *) echo "configure: unknown option: $arg" >&2; usage >&2; exit 2 ;;
  esac
done

if [ -z "$bindir" ]; then
  bindir="$prefix/bin"
fi

check_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "configure: missing required command: $1" >&2
    exit 1
  fi
}

check_pkg() {
  if ! "$pkg_config" --exists "$1"; then
    echo "configure: missing required package: $1" >&2
    echo "configure: install the development package that provides $1.pc" >&2
    exit 1
  fi
}

check_compile() {
  name=$1
  code=$2
  libs=$3
  # One temp DIRECTORY, then ordinary names inside it. The templates were
  # `shottino-conf.XXXXXX.c` — X's with a suffix after them, which GNU
  # coreutils accepts and busybox refuses outright ("mktemp: Invalid
  # argument"). On any busybox userland (alpine, most container images,
  # a fair number of embedded systems) `set -e` then killed configure at
  # the FIRST compile test, before it could report a single result. The
  # suffix is what the compiler needs, so it moves into the filename
  # where no mktemp has an opinion about it. TMPDIR is honoured because
  # /tmp is not writable everywhere either.
  tmp_d=$(mktemp -d "${TMPDIR:-/tmp}/shottino-conf.XXXXXX")
  tmp_c="$tmp_d/conf.c"
  tmp_o="$tmp_d/conf"
  printf '%s\n' "$code" > "$tmp_c"
  if ! $cc -o "$tmp_o" "$tmp_c" $libs >/dev/null 2>&1; then
    rm -rf "$tmp_d"
    echo "configure: failed compile/link test: $name" >&2
    exit 1
  fi
  rm -rf "$tmp_d"
}

check_cmd "$cc"
check_cmd "$pkg_config"
check_pkg ncursesw
check_pkg openssl

ncurses_cflags=$($pkg_config --cflags ncursesw)
ncurses_libs=$($pkg_config --libs ncursesw)
openssl_cflags=$($pkg_config --cflags openssl)
openssl_libs=$($pkg_config --libs openssl)

check_compile "pthread" '#include <pthread.h>
int main(void) { pthread_t t = (pthread_t)0; (void)t; return 0; }' '-pthread'
check_compile "ncursesw" '#include <ncurses.h>
int main(void) { initscr(); endwin(); return 0; }' "$ncurses_libs"
check_compile "openssl" '#include <openssl/ssl.h>
int main(void) { SSL_library_init(); return 0; }' "$openssl_libs"

# Feature-test macros (#2587). shottino uses a handful of names beyond
# strict POSIX — SOCK_CLOEXEC, MSG_NOSIGNAL, cfmakeraw, usleep, wcwidth —
# and ncurses' wide API (get_wch). Which macro puts them in scope differs by
# libc, and the old fixed `-D_POSIX_C_SOURCE=200809L` only worked on Linux
# by accident: Debian's ncursesw.pc adds `-D_DEFAULT_SOURCE`, which brings
# them back. On FreeBSD an explicit _POSIX_C_SOURCE turns __BSD_VISIBLE
# OFF and hides all of them, and its ncursesw ships no such flag.
#
# So: try each candidate set with the flags pkg-config gave us, keep the
# FIRST that compiles AND links the probe, and write it to config.mk. This
# is feature detection, not a uname table — a libc we have never heard of
# gets whichever set works for it. -Werror=implicit-function-declaration
# because an undeclared function is otherwise a warning that still links,
# and the probe would "pass" on exactly the host it exists to catch.
#
#   1. the historical default — glibc keeps exactly the flags it had;
#   2. no POSIX macro at all, i.e. the libc's full default visibility
#      (FreeBSD, the other BSDs), plus the switch for ncurses' wide API;
#   3. explicit XSI + extended for a glibc whose ncursesw.pc adds nothing.
feature_probe='#include <sys/types.h>
#include <sys/socket.h>
#include <termios.h>
#include <unistd.h>
#include <wchar.h>
#include <ncurses.h>
int main(void) {
  struct termios tio;
  wint_t ch;
  cfmakeraw(&tio);
  usleep(1);
  (void)get_wch(&ch);
  return (SOCK_STREAM | SOCK_CLOEXEC) + MSG_NOSIGNAL + wcwidth((wchar_t)97);
}'

feature_cppflags=
feature_ok=
for cand in '-D_POSIX_C_SOURCE=200809L' \
            '-DNCURSES_WIDECHAR=1' \
            '-D_DEFAULT_SOURCE -D_XOPEN_SOURCE=600 -D_XOPEN_SOURCE_EXTENDED'; do
  tmp_d=$(mktemp -d "${TMPDIR:-/tmp}/shottino-conf.XXXXXX")
  printf '%s\n' "$feature_probe" > "$tmp_d/conf.c"
  # shellcheck disable=SC2086 # the flag strings are word lists on purpose
  if $cc -std=c11 -Werror=implicit-function-declaration $cand \
      $ncurses_cflags $openssl_cflags -o "$tmp_d/conf" "$tmp_d/conf.c" \
      $ncurses_libs >/dev/null 2>&1; then
    feature_cppflags=$cand
    feature_ok=1
  fi
  rm -rf "$tmp_d"
  [ -n "$feature_ok" ] && break
done
if [ -z "$feature_ok" ]; then
  echo "configure: no feature-test macro set exposes SOCK_CLOEXEC, MSG_NOSIGNAL," >&2
  echo "configure: cfmakeraw, usleep, wcwidth and ncursesw's get_wch on this system" >&2
  exit 1
fi

# The call helper's link flags (`make call`, opt-in). -static-libstdc++
# -static-libgcc keep a Linux helper off the libstdc++.so.6 it would
# otherwise need at run time. clang on FreeBSD links its own libc++ from
# base and does not use them — it says "argument unused" twice and links
# libc++.so.1 anyway, which every FreeBSD has. So they go in only when the
# compiler links a program with them and says nothing about it. No C++
# compiler is not an error here: the helper is opt-in.
cxx=${CXX:-c++}
call_static_ldflags=
if command -v "$cxx" >/dev/null 2>&1; then
  tmp_d=$(mktemp -d "${TMPDIR:-/tmp}/shottino-conf.XXXXXX")
  printf 'int main(void) { return 0; }\n' > "$tmp_d/conf.cc"
  if out=$("$cxx" -o "$tmp_d/conf" "$tmp_d/conf.cc" -static-libstdc++ -static-libgcc 2>&1) &&
     [ -z "$out" ]; then
    call_static_ldflags='-static-libstdc++ -static-libgcc'
  fi
  rm -rf "$tmp_d"
fi

# GNU make. The Makefile is GNU make's dialect; on a BSD `make` is bmake,
# and the BSDmakefile beside it forwards every target to `gmake` — which
# then has to exist. Said here, not as a parse error from bmake later.
if ! make --version 2>/dev/null | grep -q 'GNU Make'; then
  if ! command -v gmake >/dev/null 2>&1; then
    echo "configure: missing GNU make: install gmake (FreeBSD: pkg install gmake)" >&2
    exit 1
  fi
fi

# Rust. shottino's E2E is vodozemac through a Rust staticlib
# (e2e/vodozemac-c), so `make` needs a cargo — and this
# used to be the one build dependency nobody probed: configure said yes on
# a host without Rust, and `make` then died inside the vodozemac rule with
# `exec: docker: not found`, which tells a user nothing about what to
# install. The probe settles it HERE and writes the answer into config.mk,
# so `make` and a later `sudo make install` (whose PATH has no
# ~/.cargo/bin) use the same cargo.
#
# The floor is the crate's own `rust-version`, read from Cargo.toml so the
# number lives in one place. A distro cargo older than that (Debian
# bookworm ships 1.63) is reported with the version found — cargo would
# refuse the edition anyway, later and less clearly.
#
# Order: CARGO=… override, then `cargo` on PATH, then rustup's default
# location (a fresh rustup install is not on PATH until a new login
# shell), then the dev-box fallback that runs the pinned Rust image through
# Docker — only when the daemon actually answers, since a docker binary
# that cannot reach it fails at exactly the same place no docker did.
rust_min=$(sed -n 's/^rust-version *= *"\([0-9.]*\)"$/\1/p' \
  "$src_dir/e2e/vodozemac-c/Cargo.toml")
if [ -z "$rust_min" ]; then
  echo "configure: cannot read rust-version from $src_dir/e2e/vodozemac-c/Cargo.toml" >&2
  exit 1
fi

# version_ge A B: true when dotted version A >= B (major.minor only).
version_ge() {
  a_maj=${1%%.*}; a_rest=${1#*.}; a_min=${a_rest%%.*}
  b_maj=${2%%.*}; b_rest=${2#*.}; b_min=${b_rest%%.*}
  [ "$a_maj" -gt "$b_maj" ] || { [ "$a_maj" -eq "$b_maj" ] && [ "$a_min" -ge "$b_min" ]; }
}

cargo=
cargo_found=
try_cargo() {
  cand=$1
  [ -n "$cand" ] && [ -x "$cand" ] || return 1
  ver=$("$cand" --version 2>/dev/null | sed -n 's/^cargo \([0-9][0-9]*\.[0-9][0-9]*\).*/\1/p')
  [ -n "$ver" ] || return 1
  if version_ge "$ver" "$rust_min"; then
    cargo=$cand
    return 0
  fi
  cargo_found="$cargo_found $cand ($ver)"
  return 1
}

if [ -n "${CARGO:-}" ]; then
  if ! try_cargo "$(command -v "$CARGO" 2>/dev/null || true)"; then
    echo "configure: CARGO=$CARGO is not a cargo $rust_min or newer${cargo_found:+ (found:$cargo_found)}" >&2
    exit 1
  fi
elif try_cargo "$(command -v cargo 2>/dev/null || true)" ||
     try_cargo "${HOME:-/nonexistent}/.cargo/bin/cargo"; then
  :
elif [ -x "$src_dir/../../scripts/shottino-cargo.sh" ] &&
     command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  cargo=$(cd "$src_dir/../../scripts" && pwd -P)/shottino-cargo.sh
fi

if [ -z "$cargo" ]; then
  cat >&2 <<EOF
configure: missing Rust: shottino needs cargo $rust_min or newer to build its
configure: end-to-end encryption (vodozemac).${cargo_found:+ Too old:$cargo_found}
configure: install it from https://rustup.rs or your distribution's rust/cargo
configure: package (if new enough), then run ./configure again.
configure: CARGO=/path/to/cargo ./configure picks a specific one.
EOF
  exit 1
fi

cat > "$src_dir/config.mk" <<EOF
# Generated by ./configure. Do not edit by hand.
PREFIX := $prefix
BINDIR := $bindir
CC := $cc
PKG_CONFIG := $pkg_config
CFLAGS_DEPS := $ncurses_cflags $openssl_cflags -pthread
LDLIBS_DEPS := $ncurses_libs $openssl_libs -pthread
FEATURE_CPPFLAGS := $feature_cppflags
CXX := $cxx
CALL_STATIC_LDFLAGS := $call_static_ldflags
CARGO := $cargo
EOF

echo "configure: wrote $src_dir/config.mk"
echo "configure: prefix=$prefix"
echo "configure: bindir=$bindir"
echo "configure: cc=$cc"
echo "configure: feature macros=$feature_cppflags"
echo "configure: cargo=$cargo"
