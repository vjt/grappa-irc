#!/bin/sh
# A stand-in for libsecret's secret-tool, for the tests: the "keyring" is a
# directory ($FAKE_KEYRING), one file per attribute set. FAKE_KEYRING_MODE
# makes it misbehave: "fail" refuses everything, "forget" takes a store and
# then has nothing to hand back. Every call is appended to $FAKE_KEYRING/log.
[ -n "$FAKE_KEYRING" ] || exit 2
cmd=$1
shift
name=
attrs=
for a in "$@"; do
	case "$a" in --label=*) ;; *) name="$name$a." attrs="$attrs $a" ;; esac
done
echo "$cmd$attrs" >>"$FAKE_KEYRING/log"
[ "$FAKE_KEYRING_MODE" = fail ] && exit 1
case "$cmd" in
store)
	cat >"$FAKE_KEYRING/$name" || exit 1
	[ "$FAKE_KEYRING_MODE" = forget ] && rm -f "$FAKE_KEYRING/$name"
	exit 0 ;;
lookup)
	[ -f "$FAKE_KEYRING/$name" ] || exit 1
	cat "$FAKE_KEYRING/$name" ;;
*) exit 2 ;;
esac
