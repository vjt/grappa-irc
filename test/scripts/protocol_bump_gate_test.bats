#!/usr/bin/env bats
# test/scripts/protocol_bump_gate_test.bats — issue 2695.
#
# scripts/protocol-bump-gate.sh: a branch that moves the facts of
# priv/wire/shape.pin must claim exactly the base TIP's protocol_version + 1.
# Each case builds a scratch repo whose main sits at protocol 66, so the
# verdicts below are the gate's own, not a reading of its source.

load ../bats_helpers

setup() {
    GATE_SRC="$BATS_TEST_DIRNAME/../../scripts/protocol-bump-gate.sh"
    REAL_REPO="$(cd "$BATS_TEST_DIRNAME/../.." && pwd -P)"
}

# pin <version> <n> → the pin's two facts: that protocol_version, and a
# well-formed sha256 digest derived from n (same n, same digest).
pin() {
    mkdir -p priv/wire
    {
        printf '# GENERATED by `mix grappa.wire_pin --update` — see that task'"'"'s moduledoc.\n#\n'
        printf 'protocol_version = %s\n' "$1"
        printf 'shape_digest = sha256:%064x\n' "$2"
    } > priv/wire/shape.pin
}

# proto_ex <version> → a lib/grappa/protocol.ex whose changelog is already
# cut to a pointer (issue 2695 S5): nothing around the number diverges.
proto_ex() {
    mkdir -p lib/grappa
    {
        printf 'defmodule Grappa.Protocol do\n'
        printf '  # The per-version changelog lives in docs/CLIENT_PROTOCOL.md.\n'
        printf '  @protocol_version %s\n' "$1"
        printf 'end\n'
    } > lib/grappa/protocol.ex
}

# A repo whose main carries protocol 66, and a `feat` branch off it.
scratch() {
    REPO="$BATS_TEST_TMPDIR/repo"
    rm -rf "$REPO"
    mkdir -p "$REPO/docs" "$REPO/scripts"
    cp "$GATE_SRC" "$REPO/scripts/protocol-bump-gate.sh"
    chmod 0755 "$REPO/scripts/protocol-bump-gate.sh"
    cd "$REPO"
    git -c init.defaultBranch=main init -q .
    git config user.email bats@example.invalid
    git config user.name bats
    printf 'INTRO\n' > docs/NOTES.md
    pin 66 1
    proto_ex 66
    git add -A
    git commit -qm base
    git checkout -qb feat
}

# On main: another branch's bump to <version> lands, with its own digest <n>.
main_lands() {
    git checkout -q main
    pin "$1" "$2"
    git commit -qam "main lands protocol $1"
    git checkout -q feat
}

@test "a branch that never moves the pin passes, however far main has moved" {
    scratch
    main_lands 67 2
    printf 'prose\n' >> docs/NOTES.md
    git commit -qam 'prose only'
    run scripts/protocol-bump-gate.sh main
    [ "$status" -eq 0 ]
    [[ "$output" == *"claims no number"* ]]
    [[ "$output" == *"main ("*") is at protocol 67"* ]]
}

@test "a branch claiming the base tip + 1 passes and names both numbers" {
    scratch
    pin 67 2
    git commit -qam 'claim 67'
    run scripts/protocol-bump-gate.sh main
    [ "$status" -eq 0 ]
    [[ "$output" == *"claims protocol 67 (merge base"*"had 66)"*"is at 66"* ]]
}

@test "two branches cut from 66 both claim 67: the one that lands second is RED" {
    scratch
    pin 67 3
    git commit -qam 'claim 67 here too'
    main_lands 67 2
    run scripts/protocol-bump-gate.sh main
    [ "$status" -eq 1 ]
    [[ "$output" == *"claims protocol 67"*"is at 67, so the next number is 68"* ]]
    [[ "$output" == *"67 is already taken on main"* ]]
}

@test "a skip is RED: a branch off 66 claiming 68" {
    scratch
    pin 68 2
    git commit -qam 'claim 68'
    run scripts/protocol-bump-gate.sh main
    [ "$status" -eq 1 ]
    [[ "$output" == *"That skips 67"* ]]
}

@test "two numbers on one branch are RED, even one commit at a time" {
    scratch
    pin 67 2
    git commit -qam 'claim 67'
    pin 68 3
    git commit -qam 'claim 68 as well'
    run scripts/protocol-bump-gate.sh main
    [ "$status" -eq 1 ]
    [[ "$output" == *"That skips 67"* ]]
}

@test "a digest moved under a still number is RED, coverage change or not" {
    scratch
    pin 66 2
    git commit -qam 'move the digest, keep 66'
    run scripts/protocol-bump-gate.sh main
    [ "$status" -eq 1 ]
    [[ "$output" == *"66 is already taken on main"* ]]
}

@test "an edit to the pin's comment header alone claims no number" {
    scratch
    sed -i.bak '1s/.*/# GENERATED, header reworded/' priv/wire/shape.pin
    rm priv/wire/shape.pin.bak
    git commit -qam 'reword the header'
    # The edit landed: the pin is not byte-identical to the merge base's.
    refute git diff --quiet main HEAD -- priv/wire/shape.pin
    run scripts/protocol-bump-gate.sh main
    [ "$status" -eq 0 ]
    [[ "$output" == *"claims no number"* ]]
}

@test "with a pointer-only protocol.ex git merges CLEAN, and the collision is still RED" {
    # Today the prose appended above @protocol_version is what makes that
    # line conflict. Cut it to a pointer (issue 2695 S5) and two identical
    # `66 -> 67` edits merge silently. The gate must not depend on that.
    scratch
    proto_ex 67
    pin 67 3
    git commit -qam 'claim 67 here too'
    git checkout -q main
    proto_ex 67
    pin 67 2
    git commit -qam 'main lands protocol 67'

    # The premise: the trial merge stops on the pin alone; protocol.ex is clean.
    git checkout -q -b trial
    run git merge --no-commit --no-ff feat
    [ "$status" -ne 0 ]
    [ "$(git diff --name-only --diff-filter=U)" = "priv/wire/shape.pin" ]
    git merge --abort

    git checkout -q feat
    run scripts/protocol-bump-gate.sh main
    [ "$status" -eq 1 ]
    [[ "$output" == *"67 is already taken on main"* ]]
}

@test "the push run: one bump, judged from the before it pushed over, passes" {
    scratch
    git checkout -q main
    pin 67 2
    git commit -qam 'land 67'
    run scripts/protocol-bump-gate.sh "$(git rev-parse HEAD~1)"
    [ "$status" -eq 0 ]
    [[ "$output" == *"claims protocol 67"* ]]
}

@test "the push run: a branch merged on a stale green reddens main after the fact" {
    # main requires no status checks, so a branch that went green against 66
    # can be fast-forwarded on top of another branch's 67. The push run is
    # the backstop, and it judges from the push's before.
    scratch
    git checkout -q main
    pin 67 2
    git commit -qam 'land 67'
    pin 67 3
    git commit -qam 'land a second 67 on a stale green'
    run scripts/protocol-bump-gate.sh "$(git rev-parse HEAD~1)"
    [ "$status" -eq 1 ]
    [[ "$output" == *"67 is already taken"* ]]
}

@test "ci.yml's push arm passes the push's before SHA, so the pushed commit is judged" {
    block="$(ci_run_block "Protocol number claimed")"
    [[ "$block" == *"protocol-bump-gate.sh"* ]]
    scratch
    git checkout -q main
    pin 67 2
    git commit -qam 'land 67'
    pin 67 3
    git commit -qam 'land a second 67 on a stale green'
    # On a push, origin/main IS the pushed tip: judged from it, nothing moved.
    git update-ref refs/remotes/origin/main "$(git rev-parse HEAD)"
    run env EVENT_NAME=push PUSH_BEFORE="$(git rev-parse HEAD~1)" bash -ec "$block"
    [ "$status" -eq 1 ]
    [[ "$output" == *"67 is already taken"* ]]
}

@test "ci.yml's pull_request arm judges the branch against origin/main" {
    block="$(ci_run_block "Protocol number claimed")"
    [[ "$block" == *"protocol-bump-gate.sh"* ]]
    scratch
    main_lands 67 2
    git update-ref refs/remotes/origin/main "$(git rev-parse main)"
    pin 67 3
    git commit -qam 'claim 67 here too'
    run env EVENT_NAME=pull_request PUSH_BEFORE= bash -ec "$block"
    [ "$status" -eq 1 ]
    [[ "$output" == *"67 is already taken on origin/main"* ]]
}

@test "a pin carrying two protocol_version lines FAILS instead of claiming nothing" {
    scratch
    printf 'protocol_version = 67\n' >> priv/wire/shape.pin
    git commit -qam 'a second version line'
    run scripts/protocol-bump-gate.sh main
    [ "$status" -eq 1 ]
    [[ "$output" == *"does not carry exactly one protocol_version and one shape_digest"* ]]
}

@test "a pin missing at HEAD FAILS instead of claiming nothing" {
    scratch
    git rm -q priv/wire/shape.pin
    git commit -qm 'drop the pin'
    run scripts/protocol-bump-gate.sh main
    [ "$status" -eq 1 ]
    [[ "$output" == *"no priv/wire/shape.pin at"* ]]
}

@test "the all-zeros SHA (a push that CREATED the ref) FAILS: the gate cannot reach a base" {
    scratch
    run scripts/protocol-bump-gate.sh 0000000000000000000000000000000000000000
    [ "$status" -eq 1 ]
    [[ "$output" == *"cannot reach"*"all-zeros"* ]]
}

@test "an EMPTY base ref FAILS instead of falling back to origin/main" {
    scratch
    # An origin/main that resolves, so a fallback would pass instead of failing.
    git update-ref refs/remotes/origin/main "$(git rev-parse main)"
    run scripts/protocol-bump-gate.sh ""
    [ "$status" -eq 1 ]
    [[ "$output" == *"cannot reach"*"EMPTY"* ]]
}

@test "an unresolvable base ref FAILS — the gate never passes vacuously" {
    scratch
    run scripts/protocol-bump-gate.sh no-such-ref
    [ "$status" -eq 1 ]
    [[ "$output" == *"cannot reach"*"no-such-ref"* ]]
}

# ── The gate against the repository it ships to guard ──────────────────────

@test "this repository's branch passes the gate against its origin/main" {
    # Runs in scripts/check.sh through scripts/bats.sh. Locally it judges
    # against YOUR origin/main, so fetch first (docs/TESTING.md).
    cd "$REAL_REPO"
    run scripts/protocol-bump-gate.sh
    [ "$status" -eq 0 ]
}
