{
  "name": "cicchetto",
  "version": "0.0.0",
  "private": true,
  "description": "Grappa PWA — irssi-shaped browser client over REST + Phoenix Channels.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "bun scripts/check.ts",
    "check:fix": "biome check --write",
    "check:radio": "bun scripts/check-radio-logos.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:emoji": "bun scripts/gen-emoji.ts",
    "sync:radio-logos": "bun scripts/sync-radio-logos.ts"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "mediabunny": "^1.55.3",
    "phoenix": "^1.8.13",
    "solid-js": "^1.9.14",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@fontsource/cascadia-code": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.0",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/phoenix": "^1.6.7",
    "hack-font": "^3.3.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "unicode-emoji-json": "^0.9.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
