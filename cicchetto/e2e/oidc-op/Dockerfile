# oidc-op — stub OpenID Provider for the #1911 login e2e.
#
# Stdlib-only (no npm install), same posture as push-catcher: the image
# stays cache-friendly and rebuilds fast. Runs as a non-root UID and needs
# no filesystem writes (keys are minted at boot; pending requests + codes
# live in-memory). Reads the TLS leaf from /certs (generated by the
# oidc-cert-init sidecar, mounted read-only) — 0644 on purpose there,
# because nobody (65534) must read the throwaway e2e key.
FROM node:22-alpine

WORKDIR /app
COPY server.mjs /app/server.mjs

USER 65534:65534

EXPOSE 3443
CMD ["node", "/app/server.mjs"]
