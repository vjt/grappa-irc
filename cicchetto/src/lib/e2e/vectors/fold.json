{
  "cases": [
    {
      "why": "A-Z folds",
      "in": "VJT",
      "out": "vjt"
    },
    {
      "why": "only A-Z: the rfc1459 national characters stay",
      "in": "NiCk[]\\~",
      "out": "nick[]\\~"
    },
    {
      "why": "brackets and braces stay distinct",
      "in": "FOO{1}",
      "out": "foo{1}"
    },
    {
      "why": "a channel folds like a nick",
      "in": "#Chan",
      "out": "#chan"
    },
    {
      "why": "non-ASCII stays as it is",
      "in": "#CAFÉ",
      "out": "#cafÉ"
    },
    {
      "why": "digits and punctuation stay",
      "in": "A-Z_09^|`",
      "out": "a-z_09^|`"
    }
  ]
}
